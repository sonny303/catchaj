# LLM API (Google AI Studio - free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Configuration
# The Google Sheet ID from https://docs.google.com/spreadsheets/d/your_google_sheet_id_here/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=service_account.json

# Notification Configuration (Gmail SMTP or Resend)
NOTIFICATION_PROVIDER=gmail
NOTIFICATION_EMAIL=alerts@example.com

# Gmail SMTP Settings (Requires App Password if 2FA enabled)
GMAIL_USER=alerts@example.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Alternative: Resend API
RESEND_API_KEY=your_resend_api_key_here
